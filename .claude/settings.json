{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh\" >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}
